# Build output
bin/
bin-int/

# zig, fetched by scripts/Get-Zig.ps1, and the caches its builds leave
vendor/bin/zig/
.zig-cache/
zig-out/

# Generated project files
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
Makefile
*.make

# Visual Studio
.vs/
*.user
*.suo

# Runtime state written next to the executable
imgui.ini
ide.ini
ide.json
graphite.json

# Per-workspace view state written by the IDE itself
.graphite/

# The premake binary is intentionally kept in the repo
!vendor/bin/
!vendor/bin/premake/
!vendor/bin/premake/premake5.exe

# Generated by scripts/New-CompileCommands.ps1, and full of absolute paths, so it belongs to
# whoever generated it rather than to the repository.
compile_commands.json

# clangd's own index, rebuilt from the sources whenever it is missing. Several megabytes of
# binary that changes on every edit - the worst possible shape for source control.
.cache/

# A developer's own clangd tree, for those who point lsp.clangd.binary.path at a copy here. Never
# committed: a hundred-megabyte binary in the history cannot practically be taken back out again.
vendor/bin/clangd/

# Internal design docs and plans, kept locally only
docs/superpowers/

# Scratch files written by subagents while executing a plan
.superpowers/

# Parallel work trees
.worktrees/
.claude/worktrees/
