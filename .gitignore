# Build output
bin/
bin-int/

# Generated project files
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
Makefile
*.make

# Visual Studio
.vs/
*.user
*.suo

# Runtime state written next to the executable
imgui.ini
ide.ini
ide.json
graphite.json

# Per-workspace view state written by the IDE itself
.graphite/

# The premake binary is intentionally kept in the repo
!vendor/bin/
!vendor/bin/premake/
!vendor/bin/premake/premake5.exe

# clangd is downloaded pre-built rather than committed - see vendor/bin/clangd/README.md.
# Only the README belongs in the repository; a hundred-megabyte binary in the history
# cannot practically be taken back out again.
vendor/bin/clangd/*
!vendor/bin/clangd/README.md

# Internal design docs and plans, kept locally only
docs/superpowers/

# Scratch files written by subagents while executing a plan
.superpowers/

# Parallel work trees
.worktrees/
.claude/worktrees/
